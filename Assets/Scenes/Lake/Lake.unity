      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: textComponent
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Hallo Gedi, wie sch\xF6n dich zu sehen."
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Ob ich ein Schwert habe? Tats\xE4chlich brauche ich meins nicht mehr,
        da ich mittlerweile zu alt daf\xFCr bin."
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Ich gebe es dir gerne, wenn du mir ein Gefallen tun k\xF6nntest."
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Drau\xDFen am See ist sehr viel Unkraut. K\xF6nntest du das bitte mit
        dem Schwert entfernen? "
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[4]
      value: Wenn du fertig bist, komm einfach zu mir. Ich werde am Weg zur Stadt
        auf dich warten!
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927245, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
      propertyPath: lines.Array.data[5]
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 1247863095402927246, guid: 27c5c8fab31ba42238cf3a4ca2ee8aa1, type: 3}
